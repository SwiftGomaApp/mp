{
  "name": "swiftgoma-mp-auth",
  "version": "0.0.1",
  "description": "Shared authentication client for the SwiftGoma apps",
  "keywords": [
    "swiftgoma",
    "auth",
    "authentication",
    "react-native",
    "expo",
    "nextjs"
  ],
  "author": "SwiftGoma Team",
  "license": "ISC",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native/index.d.ts",
        "default": "./dist/native/index.js"
      },
      "require": {
        "types": "./dist/native/index.d.cts",
        "default": "./dist/native/index.cjs"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      },
      "require": {
        "types": "./dist/web/index.d.cts",
        "default": "./dist/web/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./web/server": {
      "import": {
        "types": "./dist/web/server/index.d.ts",
        "default": "./dist/web/server/index.js"
      },
      "require": {
        "types": "./dist/web/server/index.d.cts",
        "default": "./dist/web/server/index.cjs"
      }
    },
    "./account": {
      "import": {
        "types": "./dist/account/index.d.ts",
        "default": "./dist/account/index.js"
      },
      "require": {
        "types": "./dist/account/index.d.cts",
        "default": "./dist/account/index.cjs"
      }
    },
    "./staff": {
      "import": {
        "types": "./dist/staff/index.d.ts",
        "default": "./dist/staff/index.js"
      },
      "require": {
        "types": "./dist/staff/index.d.cts",
        "default": "./dist/staff/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "native": [
        "./dist/native/index.d.cts"
      ],
      "web": [
        "./dist/web/index.d.cts"
      ],
      "react": [
        "./dist/react/index.d.cts"
      ],
      "testing": [
        "./dist/testing/index.d.cts"
      ],
      "web/server": [
        "./dist/web/server/index.d.cts"
      ],
      "account": [
        "./dist/account/index.d.cts"
      ],
      "staff": [
        "./dist/staff/index.d.cts"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "npm run build && publint && attw --pack .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run check:package"
  },
  "peerDependencies": {
    "axios": "^1.7.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axios": "^1.21.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "0.23.4",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
