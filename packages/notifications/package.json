{
  "name": "swiftgoma-mp-notifications",
  "version": "0.1.0-next.0",
  "description": "Notifications client for the SwiftGoma apps: inbox, preferences, push and live updates",
  "keywords": [
    "swiftgoma",
    "notifications",
    "push",
    "inbox",
    "react-native",
    "expo",
    "nextjs"
  ],
  "author": "SwiftGoma Team",
  "license": "ISC",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./realtime": {
      "import": {
        "types": "./dist/realtime/index.d.ts",
        "default": "./dist/realtime/index.js"
      },
      "require": {
        "types": "./dist/realtime/index.d.cts",
        "default": "./dist/realtime/index.cjs"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native/index.d.ts",
        "default": "./dist/native/index.js"
      },
      "require": {
        "types": "./dist/native/index.d.cts",
        "default": "./dist/native/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "realtime": [
        "./dist/realtime/index.d.cts"
      ],
      "native": [
        "./dist/native/index.d.cts"
      ],
      "react": [
        "./dist/react/index.d.cts"
      ],
      "testing": [
        "./dist/testing/index.d.cts"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "npm run build && publint && attw --pack .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run check:package"
  },
  "peerDependencies": {
    "axios": "^1.7.0",
    "react": ">=18",
    "socket.io-client": "^4.7.0",
    "swiftgoma-mp-auth": "^0.1.0-next.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "socket.io-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axios": "^1.21.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.0",
    "swiftgoma-mp-auth": "file:../auth",
    "tsdown": "0.23.4",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
