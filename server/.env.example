# ========================================= APP ======================================

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SECRETS_PROVIDER=dotenv
LOG_LEVEL=debug

# ========================================= DATABASE ======================================
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/swg_mp?schema=public
DB_POOL_MAX=10
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=swg:

# ========================================= MAILS ======================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@swiftgoma.com
SMTP_PASS=change-me
MAIL_FROM="SwiftGoma <no-reply@swiftgoma.com>"
MAIL_LOGO_URL=https://swiftgoma.com/email/logo.png
MAIL_SUPPORT_EMAIL=support@swiftgoma.com
MAIL_PRIVACY_URL=https://swiftgoma.com/confidentialite
MAIL_LOGO_WIDTH=240
MAIL_LOGO_HEIGHT=42

# ========================================= SMS ======================================
AT_USERNAME=sandbox
AT_API_KEY=change-me
AT_SENDER_ID=
SMS_DRY_RUN=true
SMS_TIMEOUT_MS=10000