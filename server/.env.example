# ========================================= APP ======================================

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Number of reverse proxies in front of the API (1 behind nginx/Docker). Keep false only without a proxy,
# otherwise every user shares one IP and the rate limits stop working.
TRUST_PROXY=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SECRETS_PROVIDER=dotenv
LOG_LEVEL=debug

# ========================================= DATABASE ======================================
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/swg_mp?schema=public
DB_POOL_MAX=10
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=swg:
WORKER_CONCURRENCY=5

# ========================================= MAILS ======================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@swiftgoma.com
SMTP_PASS=change-me
MAIL_FROM="SwiftGoma <no-reply@swiftgoma.com>"
MAIL_LOGO_URL=https://swiftgoma.com/email/logo.png
MAIL_SUPPORT_EMAIL=support@swiftgoma.com
MAIL_PRIVACY_URL=https://swiftgoma.com/confidentialite
MAIL_ACTIVITY_URL=https://swiftgoma.com/compte/activite
MAIL_STAFF_SETUP_URL=https://admin.swiftgoma.com/activation
MAIL_LOGO_WIDTH=240
MAIL_LOGO_HEIGHT=42

# ========================================= SMS ======================================
AT_USERNAME=sandbox
AT_API_KEY=change-me
AT_SENDER_ID=
SMS_DRY_RUN=true
SMS_TIMEOUT_MS=10000
SMS_DAILY_OTP_LIMIT=2000

# ========================================= AUTH ======================================
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
OTP_SECRET=change-me-min-32-chars
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=change-me-32-bytes-base64
TOTP_ISSUER=SwiftGoma
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=SwiftGoma
PASSKEY_ORIGINS=http://localhost:3000

# ========================================= SOCIAL LOGIN / GEO ======================================
# Comma-separated OAuth client IDs. Leave empty to disable Google or Apple sign-in.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Optional. When set, approximate login locations are looked up online (the user's IP is sent to ipinfo.io).
# When empty, only the offline database is used.
IPINFO_TOKEN=
