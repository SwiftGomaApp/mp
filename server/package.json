{
  "name": "swiftgoma-mp-server",
  "version": "0.1.0",
  "private": true,
  "description": "SwiftGoma MarketPlace API: Node.js/Express backend for auth, shops, orders, escrow payments, wallets and delivery, with QR-confirmed handover.",
  "keywords": [
    "marketplace",
    "ecommerce",
    "api",
    "express",
    "prisma",
    "postgresql",
    "redis",
    "bullmq",
    "mobile-money",
    "escrow",
    "qr-code",
    "delivery",
    "goma",
    "drc"
  ],
  "license": "UNLICENSED",
  "author": "SwiftGoma-BalekageGael",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "nodemon src/worker.js",
    "worker:start": "node src/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:migrate:prod": "node scripts/migrate.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
