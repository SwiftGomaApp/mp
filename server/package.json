    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
