        {
          "name": "2FA",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generates {{totpCode}} for requests whose name contains 'TOTP code'. Needs {{totpSecret}} from '2FA setup'.",
                  "if (pm.info.requestName.includes('TOTP code')) {",
                  "  const secret = pm.environment.get('totpSecret');",
                  "  if (!secret) {",
                  "    console.warn('Run \"2FA setup\" first: totpSecret is missing');",
                  "  } else {",
                  "    const B32 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
                  "    let bits = '';",
                  "    for (const c of secret.replace(/=+$/, '').toUpperCase()) bits += B32.indexOf(c).toString(2).padStart(5, '0');",
                  "    const key = [];",
                  "    for (let i = 0; i + 8 <= bits.length; i += 8) key.push(parseInt(bits.slice(i, i + 8), 2));",
                  "    const words = [];",
                  "    key.forEach((b, i) => { words[i >>> 2] = (words[i >>> 2] || 0) | (b << (24 - (i % 4) * 8)); });",
                  "    const keyWA = CryptoJS.lib.WordArray.create(words, key.length);",
                  "",
                  "    // Server rejects a step that was already used, so move to the next one if needed.",
                  "    const current = Math.floor(Date.now() / 30000);",
                  "    const last = Number(pm.environment.get('lastTotpStep') || 0);",
                  "    const step = Math.max(current, last + 1);",
                  "    if (step > current + 1) console.warn('TOTP step already used: wait up to 30s, then resend');",
                  "",
                  "    const mac = CryptoJS.HmacSHA1(CryptoJS.lib.WordArray.create([0, step], 8), keyWA);",
                  "    const h = [];",
                  "    for (let i = 0; i < 20; i++) h.push((mac.words[i >>> 2] >>> (24 - (i % 4) * 8)) & 0xff);",
                  "    const o = h[19] & 0xf;",
                  "    const bin = ((h[o] & 0x7f) << 24) | (h[o + 1] << 16) | (h[o + 2] << 8) | h[o + 3];",
                  "    pm.environment.set('totpCode', String(bin % 1000000).padStart(6, '0'));",
                  "    pm.environment.set('lastTotpStep', String(step));",
                  "  }",
                  "}"
                ]
              }
            }
