generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ======================================================= ENUMS ===========================================

enum Role {
  BUYER
  SELLER
  RIDER
  SUPPORT
  ADMIN
}

enum UserStatus {
  PENDING
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum AuthMethod {
  EMAIL_OTP
  PHONE_OTP
  PASSWORD
  GOOGLE
  APPLE
  PASSKEY
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum ActivityEvent {
  SIGNUP_STARTED
  SIGNUP_COMPLETED
  LOGIN_SUCCESS
  LOGIN_FAILED
  ACCOUNT_LOCKED
  LOGOUT
  LOGOUT_ALL
  SESSION_REVOKED
  SESSION_EVICTED
  TOKEN_REUSE_DETECTED
  NEW_DEVICE
  OTP_REQUESTED
  OTP_FAILED
  STEP_UP_VERIFIED
  PASSWORD_SET
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_CHANGED
  PHONE_CHANGED
  TOTP_ENABLED
  TOTP_DISABLED
  TOTP_FAILED
  BACKUP_CODES_GENERATED
  BACKUP_CODE_USED
  PASSKEY_ADDED
  PASSKEY_RENAMED
  PASSKEY_REMOVED
  ACCOUNT_SUSPENDED
  ACCOUNT_BANNED
  ACCOUNT_REACTIVATED
  SUSPICIOUS_ACTIVITY_REPORTED
  PASSWORD_REMOVED
  OAUTH_ACCOUNT_LINKED
  SECONDARY_EMAIL_ADDED
  SECONDARY_PHONE_ADDED
  SECONDARY_EMAIL_REMOVED
  STAFF_ACCOUNT_CREATED
  STAFF_SETUP_RESENT
  LOGIN_METHOD_REMOVED
  SUPPORT_REQUEST_CREATED
  SUPPORT_REQUEST_CLOSED
  SECONDARY_EMAIL_CHANGED
  SECONDARY_PHONE_CHANGED
  ACCOUNT_RECOVERY_REQUESTED
  ACCOUNT_RECOVERY_CANCELLED
  ACCOUNT_RECOVERY_COMPLETED
  SECONDARY_PHONE_REMOVED
}

enum RecoveryStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum SupportRequestStatus {
  OPEN
  CLOSED
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  EMAIL
}

enum NotificationContext {
  SECURITY
  PURCHASE
  SALE
  DELIVERY
  SUPPORT
  ADMIN
  ANNOUNCEMENT
  MARKETING
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

// ======================================================= MODELS ===========================================

// ---------------------- user model -------------------------

model User {
  id              String    @id @default(uuid())
  name            String?
  email           String?   @unique
  phone           String?   @unique
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  secondaryEmail           String?   @unique
  secondaryEmailVerifiedAt DateTime?
  secondaryPhone           String?   @unique
  secondaryPhoneVerifiedAt DateTime?

  passwordHash       String?
  role               Role
  status             UserStatus         @default(PENDING)
  verificationStatus VerificationStatus @default(NOT_SUBMITTED)
  termsVersion       String?
  privacyVersion     String?
  termsAcceptedAt    DateTime?
  ageConfirmedAt     DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  sessions                Session[]
  passkeys                Passkey[]
  totp                    TotpCredential?
  backupCodes             BackupCode[]
  activityLogs            ActivityLog[]
  recoveryRequests        AccountRecoveryRequest[]
  oauthAccounts           OAuthAccount[]
  supportRequests         SupportRequest[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  notificationSettings    NotificationSettings?
  deviceRegistrations     DeviceRegistration[]

  @@index([status, createdAt])
  @@map("users")
}

// ---------------------- oauth account model -------------------------

model OAuthAccount {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          OAuthProvider @default(GOOGLE)
  providerAccountId String
  email             String?
  emailVerifiedAt   DateTime?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@unique([provider, providerAccountId])
  @@index([userId, provider])
  @@map("oauth_accounts")
}

// ---------------------- session model -------------------------

model Session {
  id                       String         @id @default(uuid())
  userId                   String
  user                     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash         String         @unique
  previousRefreshTokenHash String?        @unique
  rotatedAt                DateTime?
  deviceId                 String
  deviceName               String?
  platform                 DevicePlatform
  authMethod               AuthMethod
  userAgent                String?
  ipAddress                String?
  city                     String?
  country                  String?
  pushToken                String?
  lastSeenAt               DateTime       @default(now())
  expiresAt                DateTime
  createdAt                DateTime       @default(now())
  revokedAt                DateTime?
  revokedReason            String?

  @@index([userId, revokedAt])
  @@index([userId, deviceId])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------- passkey model -------------------------

model Passkey {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  credentialId String    @unique
  publicKey    String
  algorithm    String    @default("ES256")
  signCount    Int       @default(0)
  deviceId     String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([userId, revokedAt])
  @@map("passkeys")
}

// ---------------------- totp model -------------------------

model TotpCredential {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted String
  confirmedAt     DateTime?
  lastUsedStep    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("totp_credentials")
}

// ---------------------- backup model -------------------------

model BackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
  @@map("backup_codes")
}

// ---------------------- activity model -------------------------

model ActivityLog {
  id         String          @id @default(uuid())
  userId     String?
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  event      ActivityEvent
  success    Boolean         @default(true)
  method     AuthMethod?
  sessionId  String?
  deviceId   String?
  deviceName String?
  platform   DevicePlatform?
  ipAddress  String?
  city       String?
  country    String?
  userAgent  String?
  target     String?
  metadata   Json?
  createdAt  DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}

// ---------------------- account recovery request model -------------------------

model AccountRecoveryRequest {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status RecoveryStatus @default(PENDING)
  reason String?

  verificationHash      String?   @unique
  verificationExpiresAt DateTime?

  reviewedBy   String?
  reviewedAt   DateTime?
  reviewReason String?

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  availableAt DateTime?
  completedAt DateTime?
  expiresAt   DateTime?

  completedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, requestedAt])
  @@index([expiresAt])
  @@map("account_recovery_requests")
}

// ---------------------- support request model (suspended accounts) -------------------------

model SupportRequest {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  status    SupportRequestStatus @default(OPEN)
  ipAddress String?
  note      String?
  closedBy  String?
  closedAt  DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("support_requests")
}

// ---------------------- notification model -------------------------

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     String
  context  NotificationContext
  priority NotificationPriority @default(NORMAL)

  title String
  body  String
  data  Json?

  dedupeKey String?

  readAt         DateTime?
  acknowledgedAt DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([userId, context, createdAt])
  @@index([type, createdAt])
  @@index([expiresAt])
  @@map("notifications")
}

// ---------------------- notification delivery model -------------------------

model NotificationDelivery {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel NotificationChannel
  status  DeliveryStatus      @default(PENDING)
  target  String?

  provider    String?
  providerRef String?
  error       String?
  skipReason  String?
  attempts    Int     @default(0)

  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  openedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([notificationId, channel])
  @@index([channel, status, createdAt])
  @@index([providerRef])
  @@map("notification_deliveries")
}

// ---------------------- notification preference model -------------------------

model NotificationPreference {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  context NotificationContext
  channel NotificationChannel
  enabled Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, context, channel])
  @@map("notification_preferences")
}

// ---------------------- notification settings model -------------------------

model NotificationSettings {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  timezone          String  @default("Africa/Lubumbashi")
  quietHoursEnabled Boolean @default(false)
  quietHoursStart   Int?
  quietHoursEnd     Int?

  marketingEmailOptIn   Boolean   @default(false)
  marketingEmailOptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_settings")
}

// ---------------------- device registration model -------------------------

model DeviceRegistration {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider       String         @default("onesignal")
  subscriptionId String         @unique
  deviceId       String
  platform       DevicePlatform
  sessionId      String?

  lastSeenAt DateTime  @default(now())
  disabledAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, disabledAt])
  @@index([userId, deviceId])
  @@map("device_registrations")
}

// ======================================================= MARKETING ===========================================

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum TrackingEventType {
  OPEN
  CLICK
  UNSUBSCRIBE
}

enum SuppressionReason {
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

// ---------------------- email template models -------------------------

model EmailTemplate {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?

  currentVersion Int @default(1)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions EmailTemplateVersion[]

  @@map("email_templates")
}

model EmailTemplateVersion {
  id         String        @id @default(uuid())
  templateId String
  template   EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  version   Int
  subject   String
  preheader String?
  html      String
  text      String?

  createdBy String
  createdAt DateTime @default(now())

  @@unique([templateId, version])
  @@map("email_template_versions")
}

// ---------------------- segment model -------------------------

model Segment {
  id          String  @id @default(uuid())
  name        String
  description String?
  rules       Json

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]

  @@index([createdAt])
  @@map("segments")
}

// ---------------------- campaign models -------------------------

model Campaign {
  id     String         @id @default(uuid())
  name   String
  status CampaignStatus @default(DRAFT)

  segmentId String?
  segment   Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  templateKey     String?
  templateVersion Int?

  subject   String
  preheader String?
  html      String
  text      String?

  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  failureReason String?

  recipientCount Int @default(0)
  sentCount      Int @default(0)
  failedCount    Int @default(0)
  skippedCount   Int @default(0)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients     CampaignRecipient[]
  trackingEvents TrackingEvent[]

  @@index([status, scheduledAt])
  @@index([createdAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  userId String
  email  String
  name   String?

  status      CampaignRecipientStatus @default(PENDING)
  skipReason  String?
  providerRef String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime                @default(now())

  trackingEvents TrackingEvent[]

  @@unique([campaignId, userId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

// ---------------------- suppression and tracking models -------------------------

model EmailSuppression {
  id        String            @id @default(uuid())
  email     String            @unique
  userId    String?
  reason    SuppressionReason
  source    String?
  createdAt DateTime          @default(now())

  @@index([reason, createdAt])
  @@map("email_suppressions")
}

model TrackingEvent {
  id          String             @id @default(uuid())
  campaignId  String
  campaign    Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientId String?
  recipient   CampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  type      TrackingEventType
  url       String?
  userAgent String?
  createdAt DateTime          @default(now())

  @@index([campaignId, type, createdAt])
  @@index([recipientId, type])
  @@map("tracking_events")
}
